APP_NAME=Free Social Automation
DATABASE_URL=sqlite:///./data/app.db
MEDIA_DIR=./media
HOST=127.0.0.1
PORT=8000
MAX_UPLOAD_MB=2048

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

PIPER_BIN=piper
PIPER_MODEL=./models/piper/voice.onnx
PIPER_VOICE_DIR=./models/piper
FFMPEG_BIN=ffmpeg

FACEBOOK_GRAPH_VERSION=v23.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

YOUTUBE_CLIENT_SECRETS_FILE=./secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=./secrets/youtube_token.json
YOUTUBE_DEFAULT_PRIVACY=private

TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
