APP_NAME=Free Social Automation
DATABASE_URL=sqlite:///./data/app.db
MEDIA_DIR=./media
HOST=0.0.0.0
PORT=8000
MAX_UPLOAD_MB=2048

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

WHISPER_BINARY=./whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=./models/whisper/ggml-base.bin

PIPER_BIN=piper
PIPER_MODEL=./models/piper/voice.onnx
PIPER_VOICE_DIR=./models/piper

FFMPEG_BIN=ffmpeg

FACEBOOK_GRAPH_VERSION=v23.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

YOUTUBE_CLIENT_SECRETS_FILE=./secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=./secrets/youtube_token.json
YOUTUBE_DEFAULT_PRIVACY=private

TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# Required for the UI/API. Use a strong unique password and HTTPS off localhost.
AUTH_USERNAME=owner
AUTH_PASSWORD=
FFPROBE_BIN=ffprobe
PROCESS_TIMEOUT=1800
SCHEDULER_ENABLED=true
# ollama (default) or argos (install backend/requirements-argos.txt)
TRANSLATION_BACKEND=ollama

# Credential profiles: secrets/accounts/<platform>-<key>.json
ACCOUNTS_DIR=./secrets/accounts
# All instances touching the same SQLite/media must share these lock locations.
RUNTIME_LOCK_FILE=./data/runtime.lock
LOCK_DIR=./data/locks
PLATFORM_POLL_HOURS=24
MAX_MEDIA_DURATION=3600
MAX_MEDIA_PIXELS=33177600
FFMPEG_THREADS=2

# TikTok Login Kit: register this exact HTTPS callback in the developer app.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_TOKEN_FILE=./secrets/tiktok_token.json
